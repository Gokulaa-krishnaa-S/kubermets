{
  "title": "Creating New AWS EKS Cluster",
  "fields": [
    {
      "name": "region",
      "type": "select",
      "label": "Region",
      "required": true,
      "options": [
        { "value": "us-east-1", "label": "US East (N. Virginia)" },
        { "value": "us-west-2", "label": "US West (Oregon)" },
        { "value": "eu-west-1", "label": "Europe (Ireland)" },
        { "value": "ap-southeast-1", "label": "Asia Pacific (Singapore)" }
      ]
    },
    {
      "name": "clusterConfiguration",
      "type": "group",
      "label": "Cluster Configuration",
      "fields": [
        {
          "name": "clusterName",
          "type": "text",
          "label": "Cluster Name",
          "required": true,
          "placeholder": "Enter Cluster Name"
        },
        {
          "name": "kubernetesVersion",
          "type": "select",
          "label": "Kubernetes Version",
          "required": true,
          "options": [
            { "value": "1.32", "label": "1.32" },
            { "value": "1.31", "label": "1.31" },
            { "value": "1.30", "label": "1.30" }
          ]
        }
      ]
    },
    {
      "name": "availabilityZones",
      "type": "checkbox-group",
      "label": "Availability Zones in the region",
      "required": true,
      "options": [
        { "value": "us-east-1a", "label": "us-east-1a" },
        { "value": "us-east-1b", "label": "us-east-1b" },
        { "value": "us-east-1c", "label": "us-east-1c" },
        { "value": "us-east-1d", "label": "us-east-1d" },
        { "value": "us-east-1e", "label": "us-east-1e" },
        { "value": "us-east-1f", "label": "us-east-1f" }
      ]
    },
    {
      "name": "networkConfiguration",
      "type": "group",
      "label": "Network Configuration",
      "required": true,
      "fields": [
        {
          "name": "vpcType",
          "type": "tab-group",
          "label": "",
          "options": [
            { "value": "new", "label": "New VPC" },
            { "value": "existing", "label": "Existing VPC" }
          ]
        },
        {
          "name": "existingVpcId",
          "type": "text",
          "label": "Existing VPC ID",
          "required": true,
          "placeholder": "Enter Existing VPC ID",
          "showIf": { "vpcType": "existing" },
          "helpText": "For requirements and setup of existing VPC, refer to Docs"
        },
        {
          "name": "privateSubnetIds",
          "type": "array",
          "label": "Private Subnet IDs",
          "required": true,
          "placeholder": "Enter Private Subnet IDs",
          "helpText": "List of existing private subnet IDs",
          "showIf": { "vpcType": "existing" }
        },
        {
          "name": "vpcCidr",
          "type": "text",
          "label": "VPC CIDR",
          "required": true,
          "placeholder": "Enter VPC CIDR (e.g., 10.0.0.0/16)",
          "helpText": "CIDR block for the VPC (e.g., 10.0.0.0/16)"
        },
        {
          "name": "publicSubnetCidrs",
          "type": "array",
          "label": "Public Subnet CIDRs",
          "required": true,
          "placeholder": "Enter Public Subnet CIDR",
          "helpText": "CIDR blocks for public subnets (e.g., 10.0.1.0/24, 10.0.2.0/24)"
        },
        {
          "name": "privateSubnetCidrs",
          "type": "array",
          "label": "Private Subnet CIDRs",
          "required": true,
          "placeholder": "Enter Private Subnet CIDR",
          "helpText": "CIDR blocks for private subnets (e.g., 10.0.3.0/24, 10.0.4.0/24)"
        }
      ]
    },
    {
      "name": "authentication",
      "type": "group",
      "label": "Authentication",
      "required": true,
      "helpText": "Choose between AWS profile or access key authentication. Admin level access is required or implement restricted access",
      "fields": [
        {
          "name": "authType",
          "type": "tab-group",
          "label": "",
          "options": [
            { "value": "profile", "label": "AWS Profile Based Auth" },
            { "value": "access-secret", "label": "Access/Secret Key Based Auth" }
          ]
        },
        {
          "name": "awsProfile",
          "type": "text",
          "label": "AWS Profile",
          "required": false,
          "placeholder": "Enter AWS Profile name",
          "helpText": "AWS profile name to use for authentication",
          "showIf": { "authType": "profile" }
        },
        {
          "name": "awsAccessKey",
          "type": "text",
          "label": "AWS Access Key for authentication",
          "required": true,
          "placeholder": "Enter AWS Access Key for authentication",
          "showIf": { "authType": "access-secret" }
        },
        {
          "name": "awsSecretKey",
          "type": "password",
          "label": "AWS Secret Key for authentication",
          "required": true,
          "placeholder": "Enter AWS Secret Key for authentication",
          "showIf": { "authType": "access-secret" }
        }
      ]
    },
    {
      "name": "s3DynamoConfig",
      "type": "group",
      "label": "S3 Bucket and DynamoDB for managing Terraform State",
      "helpText": "If not present, will be created in the next step",
      "fields": [
        {
          "name": "s3BucketName",
          "type": "text",
          "label": "S3 Bucket Name to store Terraform state",
          "required": true,
          "placeholder": "Enter S3 Bucket Name to store Terraform state"
        },
        {
          "name": "s3BucketPath",
          "type": "text",
          "label": "Key (path) where Terraform state will be stored in the bucket",
          "required": true,
          "placeholder": "Enter Key (path) where Terraform state will be stored in the bucket"
        },
        {
          "name": "dynamodbTableName",
          "type": "text",
          "label": "DynamoDB Table Name (Optional)",
          "required": false,
          "placeholder": "Enter DynamoDB Table Name"
        }
      ]
    },
    {
      "name": "resourceTags",
      "type": "group",
      "label": "Resource Tags (Optional)",
      "helpText": "Key value pairs to tag AWS resources",
      "fields": [
        {
          "name": "tags",
          "type": "key-value-array",
          "label": "",
          "itemType": "object"
        }
      ]
    },
    {
      "name": "platformFeatures",
      "type": "group",
      "label": "Platform Features",
      "helpText": "Enable or disable platform features",
      "fields": [
        { "name": "enableBlobStorage", "type": "checkbox", "label": "Enable Blob Storage" },
        { "name": "enableClusterIntegration", "type": "checkbox", "label": "Enable Cluster Integration" },
        { "name": "enableParameterStore", "type": "checkbox", "label": "Enable Parameter Store" },
        { "name": "enableRegistry", "type": "checkbox", "label": "Enable Registry" },
        { "name": "enableSecretsManager", "type": "checkbox", "label": "Enable Secrets Manager" }
      ]
    },
    {
      "name": "certificateConfig",
      "type": "group",
      "label": "Certificate and Domain (Load Balancer) (Optional)",
      "helpText": "Configuration for the load balancer for the compute cluster. Specify the type of loadbalancer (Public or Private), domain names, and SSL certificates. Disable if you have installed this in your existing cluster.",
      "fields": [
        { "name": "loadBalancerType", "type": "select", "label": "Load Balancer Type", "options": [ { "value": "public", "label": "Public" }, { "value": "private", "label": "Private" } ] },
        { "name": "domainNames", "type": "array", "label": "Domain Names", "itemType": "text" },
        { "name": "sslCertificates", "type": "array", "label": "SSL Certificates", "itemType": "text" }
      ]
    },
    {
      "name": "advancedConfiguration",
      "type": "group",
      "label": "Advanced Configuration (Optional)",
      "helpText": "Advanced configuration options for the cluster",
      "fields": [
        { "name": "nodeGroupName", "type": "text", "label": "Node Group Name", "required": false, "placeholder": "Enter Node Group Name", "helpText": "Name for the EKS node group" },
        { "name": "instanceType", "type": "select", "label": "Instance Type", "required": false, "options": [ { "value": "t3.medium", "label": "t3.medium" }, { "value": "t3.large", "label": "t3.large" }, { "value": "m5.large", "label": "m5.large" }, { "value": "m5.xlarge", "label": "m5.xlarge" }, { "value": "c5.large", "label": "c5.large" }, { "value": "c5.xlarge", "label": "c5.xlarge" } ] },
        { "name": "desiredCapacity", "type": "text", "label": "Desired Capacity", "required": false, "placeholder": "Enter desired number of nodes", "helpText": "Desired number of nodes in the node group" },
        { "name": "maxSize", "type": "text", "label": "Maximum Size", "required": false, "placeholder": "Enter maximum number of nodes", "helpText": "Maximum number of nodes in the node group" },
        { "name": "minSize", "type": "text", "label": "Minimum Size", "required": false, "placeholder": "Enter minimum number of nodes", "helpText": "Minimum number of nodes in the node group" }
      ]
    }
  ]
}


